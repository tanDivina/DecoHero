# Web app build settings (deco.hero-apps.com/app). Copy to .env.web (untracked) and fill in.
# All of these are public values that end up in the browser bundle. Never put a secret key here.
# Build with: npm run build:web   (output: dist-web/)

# Deployed API server, https, no trailing slash
EXPO_PUBLIC_API_URL=https://your-decohero-api.example.com

# Firebase console > Project settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# RevenueCat > Project settings > API keys > Web Billing public key (starts with rcb_)
EXPO_PUBLIC_RC_WEB_KEY=rcb_xxxxxxxxxxxxxxxx
