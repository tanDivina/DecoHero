# Gemini key from https://aistudio.google.com — NEVER put this in the mobile app
GEMINI_API_KEY=

# gemini-2.5-flash-image shuts down on 2 Oct 2026. Use the GA 3.1 model.
# For roughly half the cost per image, try gemini-3.1-flash-lite-image (test quality first).
IMAGE_MODEL=gemini-3.1-flash-image

# Shared secret you also paste into RevenueCat > Integrations > Webhooks > Authorization header
REVENUECAT_WEBHOOK_SECRET=

# Free credits for a brand-new install, and how many new installs one IP can claim per day
# (generous on purpose: shared Wi-Fi and carrier NAT put many real users behind one IP)
FREE_CREDITS=3
MAX_NEW_INSTALLS_PER_IP_PER_DAY=15

# Failed or undelivered designs per install per UTC day before redesign returns TOO_MANY_FAILURES
MAX_FAILURES_PER_INSTALL_PER_DAY=10

# Request limits (optional, these are the defaults)
API_LIMIT_PER_IP_PER_MIN=120
REDESIGN_LIMIT_PER_IP_PER_10MIN=60
REDESIGN_LIMIT_PER_INSTALL_PER_10MIN=12
REDESIGN_LIMIT_PER_PAID_INSTALL_PER_10MIN=40

# Hard daily spend caps (UTC day). Generation is refused (HTTP 503) once hit; resets at 00:00 UTC.
# ~$0.067 per image on gemini-3.1-flash-image, so 300/day caps the bill at about $20/day.
# Free (unpaid) users have their own lower cap so free-credit farming can't block paying users.
MAX_GENERATIONS_PER_DAY=300
MAX_FREE_GENERATIONS_PER_DAY=100

# Reverse proxies in front of the app (Railway and Render: 1). Used for per-IP limits.
TRUST_PROXY=1

# SQLite file — must live on a persistent volume in production
DB_PATH=./data/decohero.db
PORT=8080
