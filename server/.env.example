# Gemini key from https://aistudio.google.com — NEVER put this in the mobile app
GEMINI_API_KEY=

# gemini-2.5-flash-image shuts down on 2 Oct 2026. Use the GA 3.1 model.
# For roughly half the cost per image, try gemini-3.1-flash-lite-image (test quality first).
IMAGE_MODEL=gemini-3.1-flash-image

# Shared secret you also paste into RevenueCat > Integrations > Webhooks > Authorization header
REVENUECAT_WEBHOOK_SECRET=

# Free credits for a brand-new install, and how many new installs one IP can claim per day
FREE_CREDITS=3
MAX_NEW_INSTALLS_PER_IP_PER_DAY=3

# SQLite file — must live on a persistent volume in production
DB_PATH=./data/decohero.db
PORT=8080
